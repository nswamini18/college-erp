# =============================================================================
# UNIVERSITY ERP ENVIRONMENT CONFIGURATION EXAMPLE (BACKEND)
# Copy this file to .env in the server directory or root directory.
# NEVER commit .env or service-account JSON files to version control!
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL 8 Database Configuration (MySQL80 Windows Service)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=college_erp
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Google Sheets API Integration (One-Way Reporting Export)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service_account.json
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
SYNC_ADMIN_KEY=your_sync_admin_secret_key_here
